# Public site URL, used for metadata, canonicals and the sitemap.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Launch gate. "coming-soon" serves the holding page and redirects the
# site routes to /. "live" serves the full site. Read at build time, so a
# change requires a redeploy. Unset or unrecognised fails closed to
# "coming-soon".
SITE_MODE=live

# Resend — contact form and launch-notify delivery.
#
# ⚠️  UNTIL THE DOMAIN IS VERIFIED, these must be the test-domain values:
#       CONTACT_FROM_EMAIL=onboarding@resend.dev
#       CONTACT_TO_EMAIL=<your own Resend account address>
#     On the shared test domain Resend only accepts the account owner as a
#     recipient, so any other address returns 403. That is why the contact
#     form's auto-reply to the enquirer fails by design right now; it is
#     logged and swallowed, and starts working the day DNS is verified.
#     Verify at resend.com/domains, then switch these to the real domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=hello@popcornadvertising.com
CONTACT_FROM_EMAIL=website@popcornadvertising.com

# Signing secret for the Resend webhook (resend.com/webhooks), which reports
# bounces and spam complaints. OPTIONAL: without it the endpoint returns 503
# and logs that it is unconfigured, rather than trusting unsigned payloads.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
